{
  "name": "worshipcommons-api",
  "version": "1.0.0",
  "description": "WorshipCommons backend - open library of worship music",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "preinstall": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('yarn')){console.error('\\n[WorshipCommonsApi] This project uses Yarn (Berry). Run \\'yarn install\\' instead of npm/pnpm.\\n');process.exit(1)}\"",
    "clean": "rimraf dist",
    "build-layer": "rimraf layer && node tools/build-layer-package.mjs && cp yarn.lock layer/nodejs/yarn.lock && cd layer/nodejs && yarn install",
    "exec-deploy-staging": "serverless deploy --stage Staging",
    "deploy-staging": "npm-run-all build build-layer exec-deploy-staging",
    "exec-deploy-prod": "serverless deploy --stage Prod",
    "deploy-prod": "npm-run-all build build-layer exec-deploy-prod",
    "initdb": "tsx tools/migrate.ts --action=up",
    "migrate": "tsx tools/migrate.ts",
    "migrate:up": "tsx tools/migrate.ts --action=up",
    "migrate:down": "tsx tools/migrate.ts --action=down",
    "migrate:status": "tsx tools/migrate.ts --action=status",
    "migrate:create": "tsx tools/migrate-create.ts",
    "seed": "tsx tools/seed.ts",
    "lint": "eslint --fix src/",
    "lint:check": "eslint src/",
    "tsc": "tsc",
    "fix-esm": "node tools/fix-esm-imports.js",
    "build": "npm-run-all clean lint tsc fix-esm",
    "build-fast": "npm-run-all clean tsc fix-esm",
    "dev": "nodemon --watch src -e ts --exec \"tsx src/index.ts\"",
    "dev:ts": "tsx src/index.ts",
    "start": "node ."
  },
  "keywords": [],
  "author": "Live Church Solutions",
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1037.0",
    "@churchapps/apihelper": "^0.7.1",
    "@churchapps/helpers": "^1.10.1",
    "@codegenie/serverless-express": "^4.17.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "inversify": "^6.2.2",
    "inversify-express-utils": "^6.5.0",
    "kysely": "^0.28.16",
    "mysql2": "^3.22.2",
    "openai": "^7.4.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^9.39.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "serverless": "^3.40.0",
    "serverless-plugin-utils": "^0.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.15.0"
}
